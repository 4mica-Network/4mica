# --- Where this seller's 4Mica client connects -------------------------------
# The local core from `4mica-core`'s `make dev-up`. For a hosted network use
# 4MICA_NETWORK=base-sepolia instead and drop this line.
4MICA_RPC_URL=http://127.0.0.1:3000

# The key this service signs with. It needs no balance — it is an identity, and
# settlement happens against the payer's collateral.
4MICA_WALLET_PRIVATE_KEY=0x

# Optional: a self-run facilitator. Unset uses the SDK default.
4MICA_FACILITATOR_URL=http://127.0.0.1:8080

# --- What this API charges ---------------------------------------------------
# The address payments land at. Must be a wallet you have proved you control —
# the same one you select in the dashboard when you publish the listing.
PAY_TO=0x

# CAIP-2. eip155:31337 is the local anvil chain from the dev stack.
NETWORK=eip155:31337

# The token to be paid in. Omit for the chain's native asset. Use one of the
# addresses `GET http://127.0.0.1:3000/core/tokens` lists.
# ASSET=0x

# An integer in the asset's base units — not a decimal, not a number.
AMOUNT=1000

PORT=3010
# Only needed when the service is reachable at some other address.
# PUBLIC_BASE_URL=https://api.example.com
