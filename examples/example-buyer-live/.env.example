# --- Where this buyer's 4Mica client connects --------------------------------
4MICA_RPC_URL=http://127.0.0.1:3000

# The paying wallet. This one DOES need collateral deposited at 4Mica — that
# collateral is what backs every guarantee it signs.
4MICA_WALLET_PRIVATE_KEY=0x

4MICA_FACILITATOR_URL=http://127.0.0.1:8080

# --- What to buy -------------------------------------------------------------
# The paywalled endpoint. Take it from the seller's public listing page, which
# also shows the code this example is a runnable version of.
RESOURCE_URL=http://localhost:3010/quote

# Optional, and only for the log line: the listing this URL came from.
# PROFILE=4mica-workspace
# LISTING_SLUG=live-quotes
# PLAYGROUND_URL=http://localhost:3100
