{
  "name": "4mica",
  "private": true,
  "imports": {
    "#*": "./src/*"
  },
  "keywords": [],
  "type": "module",
  "exports": null,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/4mica-Network/homepage.git"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "biome check .",
    "test": "turbo run test",
    "lint:write": "biome check --write --diagnostic-level=error .",
    "lint:linter": "biome lint --write --diagnostic-level=error .",
    "typecheck": "turbo typecheck",
    "db:up": "pnpm --filter @4mica/be run db:up",
    "db:down": "pnpm --filter @4mica/be run db:down",
    "be:up": "pnpm --filter @4mica/be run be:up",
    "be:down": "pnpm --filter @4mica/be run be:down",
    "email:up": "pnpm --filter @4mica/email run email:up",
    "email:down": "pnpm --filter @4mica/email run email:down",
    "email:preview": "pnpm --filter @4mica/email run email:preview",
    "playground:up": "pnpm --filter @4mica/playground run playground:up",
    "playground:down": "pnpm --filter @4mica/playground run playground:down",
    "db:generate": "pnpm --filter @4mica/db run generate",
    "db:migrate": "pnpm --filter @4mica/db run migrate",
    "db:reset": "pnpm --filter @4mica/db run migrate:reset",
    "db:studio": "pnpm --filter @4mica/db run studio",
    "db:seed": "turbo run seed",
    "clean": "turbo clean && rm -rf node_modules",
    "check:exports": "turbo run check:exports",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@4mica/sdk* --filter=@4mica/cli && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@4mica/tsconfig": "workspace:*",
    "@types/node": "catalog:node24",
    "@types/npm-registry-fetch": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "changelogen": "catalog:",
    "esbuild": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "ky": "catalog:",
    "lint-staged": "catalog:",
    "ora": "catalog:",
    "picocolors": "catalog:",
    "rimraf": "catalog:",
    "taze": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:typescript-latest",
    "vitest": "catalog:",
    "yargs": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@wagmi/core>accounts": "*",
        "@wagmi/connectors>accounts": "*"
      },
      "allowAny": [
        "typescript"
      ]
    }
  },
  "pkg": {
    "outputPath": "./package/"
  },
  "packageManager": "pnpm@10.28.2",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "execa": "catalog:",
    "find-up": "catalog:",
    "npm-registry-fetch": "catalog:",
    "read-pkg": "catalog:",
    "terminal-link": "catalog:"
  }
}
