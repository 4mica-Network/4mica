# PORT is the port INSIDE the container. docker compose publishes nothing:
# this service has no authentication — reaching it is the authorisation — so it
# is reachable only by containers sharing the private 4mica-internal network,
# which in practice means apps/be alone.
#
# That also means `curl localhost:4100` will not reach a containerised
# instance. Go through the container instead:
#   docker exec 4mica-email wget -qO- http://127.0.0.1:4100/health
# `pnpm dev` (no container) still listens on localhost:4100 as usual.
NODE_ENV=development
HOST=0.0.0.0
PORT=4100

LOG_LEVEL=debug
LOG_DIR=logs

# Resend. With EMAIL_DRY_RUN=true the service renders the message, logs it and
# returns a synthetic id without calling the API, so it boots with no key.
# Setting EMAIL_DRY_RUN=false makes RESEND_API_KEY required.
RESEND_API_KEY=
EMAIL_DRY_RUN=true

# Default envelope. Every template may override the reply-to.
EMAIL_FROM_NAME=4Mica
EMAIL_FROM_ADDRESS=no-reply@4mica.io
EMAIL_REPLY_TO=support@4mica.io

# Absolute bases used for links and the logo inside rendered emails. Read by
# @4mica/url, which falls back to https://4mica.io when unset.
NEXT_PUBLIC_BASE_URL=https://4mica.io
NEXT_PUBLIC_APP_URL=https://app.4mica.io

# Graceful shutdown. On SIGTERM the instance reports unhealthy, waits
# SHUTDOWN_DRAIN_MS for in-flight requests, then closes. SHUTDOWN_TIMEOUT_MS is
# the hard cap on the whole sequence and must exceed the drain window and stay
# below the container's stop_grace_period.
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=20000

# Rate limiting. IP-keyed only: this service has no authenticated principal.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=300
