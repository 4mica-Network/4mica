# Clerk. The dashboard is the only app that signs users in.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# apps/be. Defaults to http://localhost:4000 when unset.
VITE_API_URL=http://localhost:4000

# Where public profiles live — `links.profile(username)` builds on this, and it
# is what "View public profile" opens. In production this is the apex, where
# nginx routes unknown first segments to apps/playground; locally the playground
# serves them itself on :3100. Unset falls back to https://4mica.io.
VITE_BASE_URL=http://localhost:3100

# The dashboard's own origin, used for links back into the app. Defaults to
# VITE_BASE_URL when unset, so set it whenever the two differ.
VITE_APP_URL=http://localhost:4173
