{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@4mica/url": ["../../packages/url/src/index.ts"],
      "@/*": ["./src/*"],
      "@api/*": ["./src/api/*"],
      "@stores/*": ["./src/stores/*"],
      "@utils/*": ["./src/utils/*"],
      "@i18n": ["./src/i18n/index.ts"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    // Carries the `@testing-library/jest-dom/vitest` side-effect import that
    // augments vitest's `Assertion` with toHaveFocus/toHaveAttribute/etc.
    // Without it in the program, `types: ["node"]` leaves those matchers
    // untyped and every component test fails to compile.
    "vitest.setup.ts",
    "tailwind.config.ts"
  ]
}
