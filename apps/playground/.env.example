NODE_ENV=development

# Next server. 3000/4000/4173/8080 are taken by web/be/dashboard.
PORT=3100
# Host bindings for docker compose.
PLAYGROUND_PORT=8081
EDGE_PORT=8088

# Must match apps/be/.env — note port 5433, not the Postgres default.
DATABASE_URL=postgresql://4mica:4mica@127.0.0.1:5433/4mica?schema=public

NEXT_PUBLIC_BASE_URL=https://4mica.io
# The dashboard. Where the avatar in the top bar links to. Locally this is
# http://localhost:4173.
NEXT_PUBLIC_APP_URL=https://app.4mica.io

# REQUIRED in production. apps/web serves the same origin and owns the bare
# /_next tree; without a prefix this app's chunks 404 with no server-side error.
# Leave empty for local dev, set to /p in the container build.
NEXT_PUBLIC_ASSET_PREFIX=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

LOG_LEVEL=debug
LOG_DIR=logs

# Shared secret for POST /api/revalidate. Empty disables the endpoint.
REVALIDATE_SECRET=
