POSTGRES_USER=4mica
POSTGRES_PASSWORD=4mica
POSTGRES_DB=4mica
POSTGRES_PORT=5433

DATABASE_URL=postgresql://4mica:4mica@127.0.0.1:5433/4mica?schema=public

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
BE_PORT=4000

LOG_LEVEL=debug
LOG_DIR=logs

CORS_ORIGINS=
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# Graceful shutdown. On SIGTERM the instance reports unhealthy, waits
# SHUTDOWN_DRAIN_MS for in-flight requests, then closes. SHUTDOWN_TIMEOUT_MS is
# the hard cap on the whole sequence and must exceed the drain window and stay
# below the container's stop_grace_period.
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=20000

# Rate limiting. IP_MAX is the edge shield applied before auth; USER_MAX is the
# per-Clerk-user budget; SENSITIVE_MAX covers credential-minting endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=300
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_SENSITIVE_MAX=10
