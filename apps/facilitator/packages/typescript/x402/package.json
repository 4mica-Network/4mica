{
  "name": "@4mica/x402",
  "version": "2.0.0-alpha.2",
  "type": "module",
  "description": "TypeScript x402 utilities for interacting with the 4Mica payment network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/4mica-Network/4mica.git",
    "directory": "apps/facilitator/packages/typescript/x402"
  },
  "homepage": "https://github.com/4mica-Network/4mica/tree/main/apps/facilitator/packages/typescript/x402#readme",
  "bugs": {
    "url": "https://github.com/4mica-Network/4mica/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/express": {
      "types": "./dist/server/express/index.d.ts",
      "import": "./dist/server/express/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:exports": "attw --pack . --profile esm-only && publint --strict",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:write": "biome check --write --diagnostic-level=error .",
    "fmt": "biome format .",
    "fmt:write": "biome format --write .",
    "demo:server": "pnpm --filter @4mica/x402-demo run server",
    "demo:client": "pnpm --filter @4mica/x402-demo run client",
    "demo:dev": "pnpm --filter @4mica/x402-demo run dev",
    "demo:actor": "pnpm --filter @4mica/x402-demo run actor-server",
    "demo:mcp": "pnpm --filter @4mica/x402-demo run mcp-server",
    "demo:balance": "pnpm --filter @4mica/x402-demo run balance"
  },
  "dependencies": {
    "@x402/core": "catalog:",
    "@x402/extensions": "catalog:",
    "@4mica/sdk": "workspace:^",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:node26",
    "express": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@x402/paywall": "^2.2.0",
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@x402/paywall": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
