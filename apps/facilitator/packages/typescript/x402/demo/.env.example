# CAIP-2 network shared by the server, client and deposit script. Base Sepolia by default.
NETWORK=eip155:84532
# Only for a self-hosted core; unset, the hosted deployment for NETWORK is used.
# CORE_URL=http://localhost:3000

# Server
PORT=3000
PAY_TO_ADDRESS=0xYourRecipientAddress
# Verifies and settles payments, and sponsors the deposit's gas. Set it empty
# for the deposit script to go self-funded from a wallet that holds ETH.
FACILITATOR_URL=https://x402.4mica.xyz

# Client and deposit
PRIVATE_KEY=0xYourPrivateKeyHere
API_URL=http://localhost:3000
DEPOSIT_AMOUNT=2
