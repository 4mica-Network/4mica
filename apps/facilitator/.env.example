# HTTP configuration
HOST=0.0.0.0
PORT=8080

# 4mica configuration
X402_SCHEME=4mica-credit
#
# REQUIRED. There is no default core API URL and no default private key — the
# facilitator refuses to start rather than silently pointing at a live core API
# or running unauthenticated.
#
# Either set X402_NETWORKS with a `coreApiUrl` and `authWalletPrivateKey` per
# entry (this wins if set)...
X402_NETWORKS=[{"network":"eip155:11155111","coreApiUrl":"https://api.4mica.xyz/","authWalletPrivateKey":"0x..."}]
# Optional additional per-network auth fields:
# X402_NETWORKS='[{"network":"eip155:11155111","coreApiUrl":"https://api.4mica.xyz/","authWalletPrivateKey":"0x...","authUrl":"https://api.4mica.xyz/","authRefreshMarginSecs":60}]'
#
# ...or leave X402_NETWORKS unset and configure a single network here. In that
# case X402_CORE_API_URL and X402_AUTH_WALLET_PRIVATE_KEY are both required.
X402_NETWORK=eip155:11155111
X402_CORE_API_URL=https://api.4mica.xyz/
X402_AUTH_WALLET_PRIVATE_KEY=
# Optional: defaults to the network's own coreApiUrl / refresh margin of 60s.
X402_AUTH_URL=
X402_AUTH_REFRESH_MARGIN_SECS=
X402_GUARANTEE_DOMAIN=
FOUR_MICA_GUARANTEE_DOMAIN=
4MICA_GUARANTEE_DOMAIN=
# Optional: multi-upstream debit facilitators (overrides X402_DEBIT_URL)
# X402_DEBIT_URLS='[{"network":"eip155:8453","debitUrl":"https://x402-base.example.com/"},{"network":"eip155:*","debitUrl":"https://x402-evm.example.com/"}]'
X402_DEBIT_URLS=
X402_DEBIT_URL=

# Optional x402 exact flow configuration
SIGNER_TYPE=
EVM_PRIVATE_KEY=
RPC_URL_BASE=
RPC_URL_BASE_SEPOLIA=
