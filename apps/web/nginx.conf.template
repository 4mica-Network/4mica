#
# Edge split for 4mica.io.
#
# Handles are bare (4mica.io/<username>), so apps/playground and apps/web share
# one root namespace. The model is therefore inverted from the usual setup:
# apps/web keeps its known routes, and the playground is the DEFAULT — an
# unrecognised first segment is a profile handle.
#
# IMPORTANT: the reserved-path regex below must stay in sync with
# `reservedSegments` in packages/url/src/index.ts. A test in
# apps/playground/src/main.test.ts fails the build if a reserved segment has no
# rule here, because a missing one silently turns a marketing route into a
# claimable handle. That test reads this file across the workspace — keep the
# path in step if either moves.
#
# This is a TEMPLATE, not a finished config: the nginx image runs envsubst over
# /etc/nginx/templates at startup. Only names matching NGINX_ENVSUBST_FILTER
# (`^MICA_`) are substituted, which is what keeps nginx's own $host,
# $remote_addr, $connection_upgrade and friends from being blanked out.
#
# The two apps no longer share a host: this container and apps/web sit on the
# 4mica.io box, and apps/playground runs beside apps/be. MICA_WEB_UPSTREAM is
# therefore a Docker service name, while MICA_PLAYGROUND_UPSTREAM is an address
# reachable across the network. Both stay behind `set` variables so the
# resolver comment below still applies to the local one.
#

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name 4mica.io www.4mica.io;

  # Both upstreams are separate compose projects that redeploy independently of
  # this container. A static `upstream { server web:3000; }` resolves once, at
  # startup, and never again — so a `docker compose down && up` of either app
  # leaves this pinned to the old container's IP and serving 502 indefinitely.
  # It is worst when this container starts while an app is down: Docker's DNS
  # answers an unknown name with the sentinel 127.0.53.53 rather than NXDOMAIN,
  # so nginx boots happily and then proxies to that address forever.
  #
  # Variable proxy_pass defers resolution to request time, which costs upstream
  # keepalive but recovers on its own within `valid=`.
  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  set $mica_web        ${MICA_WEB_UPSTREAM};
  set $mica_playground ${MICA_PLAYGROUND_UPSTREAM};

  proxy_http_version 1.1;
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade           $http_upgrade;
  proxy_set_header Connection        $connection_upgrade;

  # --- 1. apps/web ---------------------------------------------------------
  # It is a static export (`output: "export"`) and owns the bare /_next tree
  # plus the root document.

  location = / { proxy_pass $mica_web; }

  location ^~ /_next/  { proxy_pass $mica_web; }
  location ^~ /assets/ { proxy_pass $mica_web; }
  location ^~ /bg/     { proxy_pass $mica_web; }
  location ^~ /og/     { proxy_pass $mica_web; }

  location = /robots.txt           { proxy_pass $mica_web; }
  location = /sitemap.xml          { proxy_pass $mica_web; }
  location = /llms.txt             { proxy_pass $mica_web; }
  location = /favicon.ico          { proxy_pass $mica_web; }
  location = /icon.png             { proxy_pass $mica_web; }
  location = /manifest.webmanifest { proxy_pass $mica_web; }

  # Marketing pages. Mirrors `reservedSegments`.
  location ~ ^/(about|agents|blog|careers|docs|dpa|interactive-protocol|leadership|legal|partners|pricing|privacy|register|roadmap|solution|solutions|status|team|terms|waitlist)(/|$) {
    proxy_pass $mica_web;
  }

  # RSC payloads. `output: "export"` writes one beside every page — /index.txt,
  # /about.txt, /__next._tree.txt — and the client fetches them to prefetch a
  # navigation. They are NOT covered by the regex above, which requires `/` or
  # end-of-string after the segment, so without this rule every prefetch lands
  # in the handle namespace and client-side nav silently degrades to full page
  # loads. Safe as a catch-all: USERNAME_PATTERN in packages/url is
  # /^[a-z0-9_-]+$/, so no handle can ever end in ".txt". The exact-match rules
  # for /robots.txt and /llms.txt above still win — `=` outranks a regex.
  location ~ \.txt$ { proxy_pass $mica_web; }

  # --- 2. Playground assets ------------------------------------------------
  # next.config.ts sets assetPrefix=/p, so this app requests its chunks at
  # /p/_next/… . Two Next apps cannot share /_next on one origin — without the
  # prefix the edge has no way to tell whose chunk a request is for, and every
  # profile page loads unstyled with no server-side error. Strip /p here; Next
  # still serves the files at /_next internally.
  location ^~ /p/ {
    rewrite ^/p(/.*)$ $1 break;
    proxy_pass $mica_playground;
  }

  # --- 3. Playground API ---------------------------------------------------
  # /api/health, /api/og/<username>, /api/revalidate. `api` is reserved, so it
  # can never collide with a handle.
  location ^~ /api/ { proxy_pass $mica_playground; }

  # --- 4. Auth -------------------------------------------------------------
  location ^~ /sign-in     { proxy_pass $mica_playground; }
  location ^~ /sign-up     { proxy_pass $mica_playground; }
  # Clerk OAuth landing.
  location ^~ /sso-callback { proxy_pass $mica_playground; }

  # --- 5. The handle namespace ---------------------------------------------
  # Everything not claimed above is a profile.
  location / { proxy_pass $mica_playground; }
}
