.git/
.github/
.gitignore
.dockerignore

# Local tooling
.husky/
.claude/
.vscode/
.idea/
skills/

# Secrets and local env — never bake these into an image.
.env
.env.*
!.env.example

# Docs and editor noise
*.md
!README.md
.DS_Store
