{
  "name": "@4mica/x402",
  "version": "1.2.5",
  "type": "module",
  "description": "TypeScript x402 utilities for interacting with the 4Mica payment network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/4mica-Network/x402-4mica.git"
  },
  "homepage": "https://github.com/4mica-Network/x402-4mica#readme",
  "bugs": {
    "url": "https://github.com/4mica-Network/x402-4mica/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/express": {
      "types": "./dist/server/express/index.d.ts",
      "import": "./dist/server/express/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:write": "biome check --write --diagnostic-level=error .",
    "fmt": "biome format .",
    "fmt:write": "biome format --write .",
    "demo:server": "cd demo && yarn server",
    "demo:client": "cd demo && yarn client",
    "demo:dev": "cd demo && yarn dev"
  },
  "dependencies": {
    "@x402/core": "^2.9.0",
    "@x402/extensions": "^2.9.0",
    "@4mica/sdk": "^1.2.3",
    "viem": "^2.45.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.16",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.7",
    "express": "^5.2.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@x402/paywall": "^2.2.0",
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@x402/paywall": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
