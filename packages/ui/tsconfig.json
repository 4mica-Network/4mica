{
  "extends": "@4mica/tsconfig/react-library.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "components",
    "hooks",
    "lib",
    "utils",
    "stories",
    ".storybook/**/*"
  ],
  "exclude": ["dist", "storybook-static", "node_modules"]
}
