enum BannerInteractionType {
  VIEWED
  CLICKED
  DISMISSED
  VIDEO_PLAYED
}

model Banner {
  id           String    @id @default(uuid(7))
  slug         String    @unique @db.VarChar(64)
  title        String?   @db.VarChar(120)
  message      String?   @db.VarChar(280)
  url          String?   @db.VarChar(2048)
  thumbnailUrl String?   @map("thumbnail_url") @db.VarChar(2048)
  videoUrl     String?   @map("video_url") @db.VarChar(2048)
  alt          String?   @db.VarChar(160)
  isVideo      Boolean   @default(false) @map("is_video")
  priority     Int       @default(0)
  active       Boolean   @default(true)
  startsAt     DateTime? @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

