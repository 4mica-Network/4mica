generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PublicVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/**
 * The chains 4Mica settles on. Stored as an enum rather than a raw CAIP-2
 * string so a typo cannot reach a payment snippet; the CAIP-2 id, RPC and
 * explorer URLs are derived from it in application code.
 */
enum PaymentNetwork {
  BASE
  BASE_SEPOLIA
  ETHEREUM_SEPOLIA
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

model Agent {
  id             String           @id @default(uuid(7))
  projectId      String?          @map("project_id")
  environmentId  String?          @map("environment_id")
  organizationId String?          @map("organization_id")
  createdById    String?          @map("created_by_id")
  slug           String?          @db.VarChar(64)
  name           String
  headline       String?          @db.VarChar(160)
  description    String?
  avatarUrl      String?          @map("avatar_url")
  docsUrl        String?          @map("docs_url") @db.VarChar(2048)
  status         AgentStatus      @default(PENDING)
  visibility     PublicVisibility @default(PRIVATE)
  /// The chain this agent signs payment guarantees on.
  network        PaymentNetwork   @default(ETHEREUM_SEPOLIA)

  walletAddress String? @map("wallet_address") @db.VarChar(42)
  payerWalletId String? @map("payer_wallet_id")
  creditLimit   Decimal @default(0) @map("credit_limit") @db.Decimal(38, 18)

  walletId      String?  @map("wallet_id")
  payToAddress  String?  @map("pay_to_address") @db.VarChar(42)
  assetAddress  String?  @map("asset_address") @db.VarChar(42)
  priceAmount   Decimal? @map("price_amount") @db.Decimal(38, 18)
  priceCurrency String?  @map("price_currency") @db.VarChar(16)
  priceLabel    String?  @map("price_label") @db.VarChar(64)
  endpointUrl   String?  @map("endpoint_url") @db.VarChar(2048)
  x402Endpoint  String?  @map("x402_endpoint") @db.VarChar(2048)

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  environment  Environment?  @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  createdBy           User?                @relation("AgentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  payerWallet         Wallet?              @relation("AgentPayerWallet", fields: [payerWalletId], references: [id], onDelete: SetNull)
  wallet              Wallet?              @relation("AgentRecipientWallet", fields: [walletId], references: [id], onDelete: SetNull)
  payments            Payment[]
  reviews             Review[]
  reports             Report[]
  policy              ResourcePolicy?
  faqs                FaqItem[]
  apiKeys             ApiKey[]
  spendingPolicies    SpendingPolicy[]
  spendAuthorizations SpendAuthorization[]

  @@unique([walletAddress, network])
  @@unique([organizationId, slug])
  @@index([status])
  @@index([organizationId, visibility])
  @@index([projectId, environmentId])
  @@map("agents")
}

enum KybStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessType {
  SOLE_TRADER
  PARTNERSHIP
  LLC
  CORPORATION
  NON_PROFIT
}

enum MonthlyVolume {
  UNDER_10K
  FROM_10K_TO_100K
  FROM_100K_TO_1M
  OVER_1M
}

enum CustomerBase {
  BUSINESSES
  CONSUMERS
  BOTH
}

enum FundsSource {
  BUSINESS_REVENUE
  INVESTMENT
  LOANS
  PERSONAL_SAVINGS
  OTHER
}

enum OwnerRole {
  OWNER
  DIRECTOR
  CONTROLLER
  SIGNATORY
}

enum NotificationPlacement {
  topLeft
  topRight
  bottomLeft
  bottomRight
}

enum WebhookStatus {
  ENABLED
  DISABLED
}

enum WalletRole {
  PAYER
  RECIPIENT
  BOTH
}

enum WalletStatus {
  ACTIVE
  PAUSED
  RETIRED
}

enum WalletVerificationMethod {
  EOA_SIGNATURE
  ERC1271
}

enum OrgRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
  FINANCE
}

enum MembershipSource {
  INVITATION
  CREATOR
  SCIM
  DOMAIN
}

enum SsoProvider {
  OKTA
  MICROSOFT_ENTRA
  GOOGLE_WORKSPACE
  CUSTOM
}

enum AuditStreamStatus {
  ACTIVE
  PAUSED
  FAILING
}

enum SpendingPolicyScope {
  ORGANIZATION
  PROJECT
  AGENT
  API_KEY
}

enum SpendingPolicyMode {
  ENFORCE
  MONITOR
}

enum SpendAuthorizationStatus {
  RESERVED
  PENDING_APPROVAL
  CONSUMED
  RELEASED
  EXPIRED
  DENIED
}

enum ApprovalKind {
  PAYMENT
  SELLER_PAYMENT
  GOVERNANCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ApprovalVote {
  APPROVE
  REJECT
}

enum FinancialAlertKind {
  BUDGET_THRESHOLD
  UNAUTHORIZED_SPEND
  POLICY_DENIAL
  APPROVAL_REQUESTED
}

enum ProjectRole {
  ADMIN
  DEVELOPER
  VIEWER
}

enum EnvironmentKind {
  SANDBOX
  PRODUCTION
}

enum ApiKeyScope {
  PAYMENTS_WRITE
  CUSTOMERS_READ
  RESOURCE_READ
  SPEND_AUTHORIZE
  APPROVALS_WRITE
}

model Organization {
  id        String    @id @default(uuid(7))
  handle    String?   @unique @db.VarChar(64)
  name      String    @default("") @db.VarChar(120)
  avatarUrl String?   @map("avatar_url")
  personal  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships           Membership[]
  invitations           Invitation[]
  auditLogs             AuditLog[]
  defaultFor            User[]                    @relation("UserDefaultOrganization")
  agents                Agent[]
  apiListings           ApiListing[]
  apiKeys               ApiKey[]
  payments              Payment[]
  customers             Customer[]
  customerCoupons       CustomerCoupon[]
  customerCreditEntries CustomerCreditEntry[]
  customerIdentities    CustomerPaymentIdentity[]
  webhooks              Webhook[]
  business              Business?
  complianceProfile     ComplianceProfile?
  beneficialOwners      BeneficialOwner[]
  wallets               Wallet[]
  supportRequests       SupportRequest[]
  projects              Project[]
  serviceAccounts       ServiceAccount[]
  spendingPolicies      SpendingPolicy[]
  spendAuthorizations   SpendAuthorization[]
  approvalRequests      ApprovalRequest[]
  governanceSettings    GovernanceSettings?
  financialAlerts       FinancialAlert[]
  domains               OrganizationDomain[]
  ssoConnections        SsoConnection[]
  securitySettings      SecuritySettings?
  customRoles           CustomRole[]
  scimTokens            ScimToken[]
  scimGroups            ScimGroup[]
  auditStreams          AuditStream[]
  cliSessions           CliSession[]

  @@map("organizations")
}

model Project {
  id                 String    @id @default(uuid(7))
  organizationId     String    @map("organization_id")
  slug               String    @db.VarChar(64)
  name               String    @db.VarChar(120)
  description        String?   @db.VarChar(280)
  isDefault          Boolean   @default(false) @map("is_default")
  restricted         Boolean   @default(false)
  restrictProduction Boolean   @default(false) @map("restrict_production")
  archivedAt         DateTime? @map("archived_at")
  deletedAt          DateTime? @map("deleted_at")
  createdById        String?   @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy           User?                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  environments        Environment[]
  members             ProjectMembership[]
  serviceAccounts     ServiceAccount[]
  agents              Agent[]
  apiListings         ApiListing[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  customers           Customer[]
  payments            Payment[]
  spendingPolicies    SpendingPolicy[]
  spendAuthorizations SpendAuthorization[]
  approvalRequests    ApprovalRequest[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

model Environment {
  id        String          @id @default(uuid(7))
  projectId String          @map("project_id")
  kind      EnvironmentKind
  createdAt DateTime        @default(now()) @map("created_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agents      Agent[]
  apiListings ApiListing[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]

  @@unique([projectId, kind])
  @@map("environments")
}

model ProjectMembership {
  id        String      @id @default(uuid(7))
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(DEVELOPER)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_memberships")
}

model ServiceAccount {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id")
  name           String    @db.VarChar(120)
  description    String?   @db.VarChar(280)
  suspendedAt    DateTime? @map("suspended_at")
  deletedAt      DateTime? @map("deleted_at")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ServiceAccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  apiKeys      ApiKey[]

  spendAuthorizations SpendAuthorization[]

  @@index([projectId, createdAt(sort: Desc)])
  @@map("service_accounts")
}

model SpendingPolicy {
  id                String              @id @default(uuid(7))
  organizationId    String              @map("organization_id")
  name              String              @db.VarChar(120)
  scope             SpendingPolicyScope
  projectId         String?             @map("project_id")
  agentId           String?             @map("agent_id")
  apiKeyId          String?             @map("api_key_id")
  mode              SpendingPolicyMode  @default(ENFORCE)
  network           PaymentNetwork?
  assetAddress      String?             @map("asset_address") @db.VarChar(42)
  perPaymentLimit   Decimal?            @map("per_payment_limit") @db.Decimal(38, 18)
  dailyLimit        Decimal?            @map("daily_limit") @db.Decimal(38, 18)
  monthlyLimit      Decimal?            @map("monthly_limit") @db.Decimal(38, 18)
  approvalThreshold Decimal?            @map("approval_threshold") @db.Decimal(38, 18)
  approvalsRequired Int                 @default(1) @map("approvals_required")
  allowedRecipients String[]            @default([]) @map("allowed_recipients")
  alertThresholds   Int[]               @default([80, 100]) @map("alert_thresholds")
  frozenAt          DateTime?           @map("frozen_at")
  enabled           Boolean             @default(true)
  createdById       String?             @map("created_by_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent          Agent?               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?              @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("SpendingPolicyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  authorizations SpendAuthorization[]
  alerts         FinancialAlert[]

  @@index([organizationId, scope])
  @@index([projectId])
  @@index([agentId])
  @@index([apiKeyId])
  @@map("spending_policies")
}

model SpendAuthorization {
  id                String                   @id @default(uuid(7))
  organizationId    String                   @map("organization_id")
  projectId         String                   @map("project_id")
  environment       EnvironmentKind
  apiKeyId          String?                  @map("api_key_id")
  issuedByKeyId     String?                  @map("issued_by_key_id")
  issuedByKeyPrefix String?                  @map("issued_by_key_prefix") @db.VarChar(32)
  serviceAccountId  String?                  @map("service_account_id")
  agentId           String?                  @map("agent_id")
  network           PaymentNetwork
  assetAddress      String?                  @map("asset_address") @db.VarChar(42)
  payerAddress      String                   @map("payer_address") @db.VarChar(42)
  recipientAddress  String                   @map("recipient_address") @db.VarChar(42)
  amount            Decimal                  @db.Decimal(38, 18)
  authorizedAmount  Decimal?                 @map("authorized_amount") @db.Decimal(38, 18)
  settledAmount     Decimal?                 @map("settled_amount") @db.Decimal(38, 18)
  reqId             String?                  @map("req_id") @db.VarChar(66)
  reqIdConflict     String?                  @map("req_id_conflict") @db.VarChar(64)
  status            SpendAuthorizationStatus
  deniedReason      String?                  @map("denied_reason") @db.VarChar(64)
  policyId          String?                  @map("policy_id")
  approvalRequestId String?                  @unique @map("approval_request_id")
  paymentId         String?                  @map("payment_id")
  matchedAt         DateTime?                @map("matched_at")
  expiresAt         DateTime                 @map("expires_at")
  consumedAt        DateTime?                @map("consumed_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKey          ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  serviceAccount  ServiceAccount?  @relation(fields: [serviceAccountId], references: [id], onDelete: SetNull)
  agent           Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  policy          SpendingPolicy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([organizationId, network, assetAddress, createdAt])
  @@index([organizationId, reqId])
  @@index([apiKeyId, createdAt])
  @@index([serviceAccountId, createdAt])
  @@index([agentId, createdAt])
  @@map("spend_authorizations")
}

model ApprovalRequest {
  id                  String         @id @default(uuid(7))
  organizationId      String         @map("organization_id")
  projectId           String?        @map("project_id")
  kind                ApprovalKind
  action              String         @db.VarChar(64)
  summary             String         @db.VarChar(280)
  payload             Json
  payloadHash         String         @map("payload_hash") @db.VarChar(64)
  requestedById       String?        @map("requested_by_id")
  requestedByApiKeyId String?        @map("requested_by_api_key_id")
  requiredApprovals   Int            @default(1) @map("required_approvals")
  status              ApprovalStatus @default(PENDING)
  expiresAt           DateTime       @map("expires_at")
  decidedAt           DateTime?      @map("decided_at")
  executedAt          DateTime?      @map("executed_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedBy        User?               @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decisions          ApprovalDecision[]
  spendAuthorization SpendAuthorization?

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, action, payloadHash])
  @@map("approval_requests")
}

model ApprovalDecision {
  id                String       @id @default(uuid(7))
  approvalRequestId String       @map("approval_request_id")
  userId            String       @map("user_id")
  vote              ApprovalVote
  comment           String?      @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([approvalRequestId, userId])
  @@map("approval_decisions")
}

model GovernanceSettings {
  organizationId      String   @id @map("organization_id")
  approvalsRequired   Int      @default(0) @map("approvals_required")
  governedActions     String[] @default([]) @map("governed_actions")
  approvalTtlHours    Int      @default(72) @map("approval_ttl_hours")
  financeRecipientIds String[] @default([]) @map("finance_recipient_ids")
  auditRetentionDays  Int?     @map("audit_retention_days")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("governance_settings")
}

model FinancialAlert {
  id               String             @id @default(uuid(7))
  organizationId   String             @map("organization_id")
  projectId        String?            @map("project_id")
  kind             FinancialAlertKind
  policyId         String?            @map("policy_id")
  title            String             @db.VarChar(160)
  detail           Json
  dedupeKey        String?            @map("dedupe_key") @db.VarChar(160)
  acknowledgedAt   DateTime?          @map("acknowledged_at")
  acknowledgedById String?            @map("acknowledged_by_id")
  createdAt        DateTime           @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy       SpendingPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("financial_alerts")
}

model OrganizationDomain {
  id                String    @id @default(uuid(7))
  organizationId    String    @map("organization_id")
  domain            String    @db.VarChar(253)
  verificationToken String    @map("verification_token") @db.VarChar(64)
  verifiedAt        DateTime? @map("verified_at")
  lastCheckedAt     DateTime? @map("last_checked_at")
  autoJoin          Boolean   @default(false) @map("auto_join")
  autoJoinRole      OrgRole   @default(VIEWER) @map("auto_join_role")
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("OrganizationDomainCreator", fields: [createdById], references: [id], onDelete: SetNull)
  ssoConnections SsoConnection[]

  @@unique([organizationId, domain])
  @@index([domain])
  @@map("organization_domains")
}

model SsoConnection {
  id                String      @id @default(uuid(7))
  organizationId    String      @map("organization_id")
  domainId          String      @map("domain_id")
  provider          SsoProvider
  name              String      @db.VarChar(120)
  clerkConnectionId String?     @unique @map("clerk_connection_id")
  idpEntityId       String?     @map("idp_entity_id") @db.VarChar(2048)
  idpSsoUrl         String?     @map("idp_sso_url") @db.VarChar(2048)
  idpMetadataUrl    String?     @map("idp_metadata_url") @db.VarChar(2048)
  active            Boolean     @default(false)
  enforced          Boolean     @default(false)
  jitProvisioning   Boolean     @default(true) @map("jit_provisioning")
  defaultRole       OrgRole     @default(VIEWER) @map("default_role")
  createdById       String?     @map("created_by_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain       OrganizationDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("SsoConnectionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("sso_connections")
}

model SecuritySettings {
  organizationId               String   @id @map("organization_id")
  requireMfa                   Boolean  @default(false) @map("require_mfa")
  sessionMaxAgeHours           Int?     @map("session_max_age_hours")
  reauthWindowMinutes          Int      @default(15) @map("reauth_window_minutes")
  ipAllowlist                  String[] @default([]) @map("ip_allowlist")
  enforceIpAllowlistForApiKeys Boolean  @default(false) @map("enforce_ip_allowlist_for_api_keys")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("security_settings")
}

model CustomRole {
  id             String      @id @default(uuid(7))
  organizationId String      @map("organization_id")
  name           String      @db.VarChar(64)
  description    String?     @db.VarChar(280)
  permissions    String[]
  projectRole    ProjectRole @default(VIEWER) @map("project_role")
  createdById    String?     @map("created_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CustomRoleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships  Membership[]
  scimGroups   ScimGroup[]

  @@unique([organizationId, name])
  @@map("custom_roles")
}

model ScimToken {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  name           String    @db.VarChar(120)
  prefix         String    @db.VarChar(32)
  last4          String    @db.VarChar(4)
  hashedToken    String    @unique @map("hashed_token")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ScimTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("scim_tokens")
}

model ScimGroup {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  externalId     String?  @map("external_id") @db.VarChar(255)
  displayName    String   @map("display_name") @db.VarChar(255)
  role           OrgRole?
  customRoleId   String?  @map("custom_role_id")
  priority       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole   CustomRole?       @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  members      ScimGroupMember[]

  @@unique([organizationId, displayName])
  @@index([organizationId, externalId])
  @@map("scim_groups")
}

model ScimGroupMember {
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  group ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("scim_group_members")
}

model AuditStream {
  id                  String            @id @default(uuid(7))
  organizationId      String            @map("organization_id")
  name                String            @db.VarChar(120)
