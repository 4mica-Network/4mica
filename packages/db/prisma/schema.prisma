generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PublicVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/**
 * The chains 4Mica settles on. Stored as an enum rather than a raw CAIP-2
 * string so a typo cannot reach a payment snippet; the CAIP-2 id, RPC and
 * explorer URLs are derived from it in application code.
 */
enum PaymentNetwork {
  BASE
  BASE_SEPOLIA
  ETHEREUM_SEPOLIA
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

model Agent {
  id          String           @id @default(uuid(7))
  ownerId     String?          @map("owner_id")
  slug        String?          @db.VarChar(64)
  name        String
  headline    String?          @db.VarChar(160)
  description String?
  avatarUrl   String?          @map("avatar_url")
  docsUrl     String?          @map("docs_url") @db.VarChar(2048)
  status      AgentStatus      @default(PENDING)
  visibility  PublicVisibility @default(PRIVATE)
  /// The chain this agent signs payment guarantees on.
  network     PaymentNetwork   @default(ETHEREUM_SEPOLIA)

  walletAddress String? @map("wallet_address") @db.VarChar(42)
  payerWalletId String? @map("payer_wallet_id")
  creditLimit   Decimal @default(0) @map("credit_limit") @db.Decimal(38, 18)

  walletId      String?  @map("wallet_id")
  payToAddress  String?  @map("pay_to_address") @db.VarChar(42)
  assetAddress  String?  @map("asset_address") @db.VarChar(42)
  priceAmount   Decimal? @map("price_amount") @db.Decimal(38, 18)
  priceCurrency String?  @map("price_currency") @db.VarChar(16)
  priceLabel    String?  @map("price_label") @db.VarChar(64)
  endpointUrl   String?  @map("endpoint_url") @db.VarChar(2048)
  x402Endpoint  String?  @map("x402_endpoint") @db.VarChar(2048)

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  payerWallet Wallet?         @relation("AgentPayerWallet", fields: [payerWalletId], references: [id], onDelete: SetNull)
  wallet      Wallet?         @relation("AgentRecipientWallet", fields: [walletId], references: [id], onDelete: SetNull)
  payments    Payment[]
  reviews     Review[]
  reports     Report[]
  policy      ResourcePolicy?

  @@unique([walletAddress, network])
  @@unique([ownerId, slug])
  @@index([status])
  @@index([ownerId, visibility])
  @@map("agents")
}

enum KybStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessType {
  SOLE_TRADER
  PARTNERSHIP
  LLC
  CORPORATION
  NON_PROFIT
}

enum NotificationPlacement {
  topLeft
  topRight
  bottomLeft
  bottomRight
}

enum WebhookStatus {
  ENABLED
  DISABLED
}

enum WalletRole {
  PAYER
  RECIPIENT
  BOTH
}

enum WalletStatus {
  ACTIVE
  PAUSED
  RETIRED
}

enum WalletVerificationMethod {
  EOA_SIGNATURE
  ERC1271
}

model User {
  id                             String                   @id @default(uuid(7))
  clerkUserId                    String                   @unique @map("clerk_user_id")
  username                       String?                  @unique @db.VarChar(64)
  name                           String                   @default("")
  email                          String?                  @unique @db.VarChar(255)
  emailVerified                  Boolean                  @default(false) @map("email_verified")
  phoneNumber                    String?                  @unique @map("phone_number") @db.VarChar(20)
  phoneNumberVerified            Boolean                  @default(false) @map("phone_number_verified")
  avatarUrl                      String?                  @map("avatar_url")
  description                    String?
  bio                            String?
  private                        Boolean                  @default(true)
  hidden                         Boolean                  @default(false)
  verified                       Boolean                  @default(false)
  locked                         Boolean                  @default(false)
  banned                         Boolean                  @default(false)
  theme                          String                   @default("dark")
  appTheme                       String                   @default("dark") @map("app_theme")
  language                       String                   @default("en")
  timeZone                       String                   @default("UTC") @map("time_zone")
  privacyMode                    Boolean                  @default(false) @map("privacy_mode")
  twoFactorEnabled               Boolean                  @default(false) @map("two_factor_enabled")
  defaultHome                    String                   @default("overview") @map("default_home")
  disableBranding                Boolean                  @default(false) @map("disable_branding")
  allowCustomBrandColor          Boolean                  @default(false) @map("allow_custom_brand_color")
  primaryBrandColor              String                   @default("") @map("primary_brand_color")
  secondaryBrandColor            String                   @default("") @map("secondary_brand_color")
  allowSEOIndexing               Boolean                  @default(false) @map("allow_seo_indexing")
  allowNotification              Boolean                  @default(true) @map("allow_notification")
  allowSMS                       Boolean                  @default(false) @map("allow_sms")
  notificationPlacement          NotificationPlacement    @default(bottomRight) @map("notification_placement")
  allowMonthlyEmails             Boolean                  @default(true) @map("allow_monthly_emails")
  allowInviteAcceptedEmails      Boolean                  @default(true) @map("allow_invite_accepted_emails")
  allowChangelogNewsletterEmails Boolean                  @default(true) @map("allow_changelog_newsletter_emails")
  allowMarketingOnboardingEmails Boolean                  @default(true) @map("allow_marketing_onboarding_emails")
  allowPrivacyLegalEmails        Boolean                  @default(true) @map("allow_privacy_legal_emails")
  allowDpaEmails                 Boolean                  @default(true) @map("allow_dpa_emails")
  allowEmailVisibility           Boolean                  @default(true) @map("allow_email_visibility")
  allowPhoneNumberVisibility     Boolean                  @default(true) @map("allow_phone_number_visibility")
  completeOnboarding             Boolean                  @default(false) @map("complete_onboarding")
  isSeeded                       Boolean                  @default(false) @map("is_seeded")
  lastViewed                     String?                  @map("last_viewed")
  lastLogin                      DateTime                 @default(now()) @map("last_login")
  lastSeenAt                     DateTime                 @default(now()) @map("last_seen_at")
  usageTime                      Int                      @default(0) @map("usage_time")
  createdAt                      DateTime                 @default(now()) @map("created_at")
  updatedAt                      DateTime                 @updatedAt @map("updated_at")
  deletedAt                      DateTime?                @map("deleted_at")
  business                       Business?
  apiKeys                        ApiKey[]
  webhooks                       Webhook[]
  agents                         Agent[]
  apiListings                    ApiListing[]
  reviews                        Review[]
  reports                        Report[]
  bannerInteractions             BannerInteraction[]
  emailVerificationTokens        EmailVerificationToken[]
  onboardingQueue                OnboardingEmailQueue?
  wallets                        Wallet[]
  walletNonces                   WalletNonce[]
  reportedPayments               Payment[]

  @@index([email])
  @@map("users")
}

model EmailVerificationToken {
  id         String    @id @default(uuid(7))
  userId     String    @map("user_id")
  email      String    @db.VarChar(255)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

enum OnboardingEmailQueueStatus {
  PENDING
  SENDING
  PAUSED
  COMPLETED
}

model OnboardingEmailQueue {
  id             String                     @id @default(uuid(7))
  userId         String                     @unique @map("user_id")
  status         OnboardingEmailQueueStatus @default(PENDING)
  sequenceIndex  Int                        @default(0) @map("sequence_index")
  step           String                     @db.VarChar(64)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now()) @map("next_attempt_at")
  lastAttemptAt  DateTime?                  @map("last_attempt_at")
  lastSentAt     DateTime?                  @map("last_sent_at")
  lastProviderId String?                    @map("last_provider_id") @db.VarChar(128)
  lastError      String?                    @map("last_error") @db.VarChar(512)
  lockedUntil    DateTime?                  @map("locked_until")
  lockId         String?                    @map("lock_id") @db.VarChar(64)
  completedAt    DateTime?                  @map("completed_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sends OnboardingEmailSend[]

  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@map("onboarding_email_queue")
}

model OnboardingEmailSend {
  id             String   @id @default(uuid(7))
  queueId        String   @map("queue_id")
  userId         String   @map("user_id")
  step           String   @db.VarChar(64)
  sequenceIndex  Int      @map("sequence_index")
  attempt        Int
  succeeded      Boolean  @default(false)
  providerId     String?  @map("provider_id") @db.VarChar(128)
  error          String?  @db.VarChar(512)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(256)
  createdAt      DateTime @default(now()) @map("created_at")

  queue OnboardingEmailQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([queueId])
  @@map("onboarding_email_sends")
}

model ApiKey {
  id         String    @id @default(uuid(7))
  ownerId    String    @map("owner_id")
  name       String    @db.VarChar(120)
  prefix     String    @db.VarChar(32)
  last4      String    @db.VarChar(4)
  hashedKey  String    @unique @map("hashed_key")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("api_keys")
}

model ApiListing {
  id          String           @id @default(uuid(7))
  ownerId     String           @map("owner_id")
  slug        String           @db.VarChar(64)
  name        String           @db.VarChar(120)
  summary     String?          @db.VarChar(280)
  description String?
  baseUrl     String?          @map("base_url") @db.VarChar(2048)
  docsUrl     String?          @map("docs_url") @db.VarChar(2048)
  category    String?          @db.VarChar(64)
  tags        String[]
  /// Human display string ("Free in sandbox", "Usage-based"). The machine
  /// price that drives payment snippets is `priceAmount`/`priceCurrency`.
  priceLabel  String?          @map("price_label") @db.VarChar(64)
  visibility  PublicVisibility @default(PRIVATE)
  publishedAt DateTime?        @map("published_at")

  // --- x402 payment facts. Nullable because a listing can be published as a
  // --- description before its owner has wired up payments.
  walletId      String?         @map("wallet_id")
  network       PaymentNetwork?
  /// The seller's receiving address. Safe to expose publicly — the x402
  /// handshake advertises it in the 402 response body.
  payToAddress  String?         @map("pay_to_address") @db.VarChar(42)
  /// ERC-20 token accepted for payment. Null means the chain's native asset.
  assetAddress  String?         @map("asset_address") @db.VarChar(42)
  priceAmount   Decimal?        @map("price_amount") @db.Decimal(38, 18)
  priceCurrency String?         @map("price_currency") @db.VarChar(16)
  /// The endpoint that issues tabs / advertises requirements
  /// (`paymentRequirements.extra.tabEndpoint`).
  x402Endpoint  String?         @map("x402_endpoint") @db.VarChar(2048)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  wallet    Wallet?         @relation(fields: [walletId], references: [id], onDelete: SetNull)
  endpoints ApiEndpoint[]
  payments  Payment[]
  reviews   Review[]
  reports   Report[]
  policy    ResourcePolicy?

  @@unique([ownerId, slug])
  @@index([ownerId, visibility])
  @@map("api_listings")
}

/**
 * One priced route on an `ApiListing`. Exists so an integration snippet can
 * name a real method and path instead of a placeholder.
 */
model ApiEndpoint {
  id          String     @id @default(uuid(7))
  listingId   String     @map("listing_id")
  method      HttpMethod @default(GET)
  path        String     @db.VarChar(512)
  summary     String?    @db.VarChar(280)
  /// Overrides the listing price for this route when set.
  priceAmount Decimal?   @map("price_amount") @db.Decimal(38, 18)
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  listing ApiListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, method, path])
  @@index([listingId])
  @@map("api_endpoints")
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
}

/**
 * One x402 payment, as reported by the resource server that took it.
 *
 * 4Mica is not in the payment path — the seller's own service calls the
 * facilitator directly — so this is a reported ledger, not an authoritative
 * one. It exists because core cannot answer the questions a dashboard needs:
 * core has no payer-side query at all, and no idea which listing was paid.
 *
 * `ownerId` is whoever reported the row, which is the seller. Visibility is
 * NOT scoped to it: both sides see a payment by matching `payerAddress` or
 * `recipientAddress` against the wallets they have proved they control, so one
 * row serves the buyer and the seller without being stored twice.
 */
model Payment {
  id      String @id @default(uuid(7))
  ownerId String @map("owner_id")

  listingId String? @map("listing_id")
  agentId   String? @map("agent_id")

  payerAddress     String         @map("payer_address") @db.VarChar(42)
  recipientAddress String         @map("recipient_address") @db.VarChar(42)
  network          PaymentNetwork
  /// ERC-20 paid in. Null means the chain's native asset.
  assetAddress     String?        @map("asset_address") @db.VarChar(42)
  amount           Decimal        @db.Decimal(38, 18)

  status        PaymentStatus @default(PENDING)
  failureReason String?       @map("failure_reason") @db.VarChar(280)

  /// Minted by the payer, one per payment, and rejected as a duplicate by
  /// core. That makes it the natural idempotency key for reporting.
  reqId              String  @map("req_id") @db.VarChar(66)
  guaranteeClaims    String? @map("guarantee_claims")
  guaranteeSignature String? @map("guarantee_signature")
  txHash             String? @map("tx_hash") @db.VarChar(66)

  /// The URL that was paid for, and a human label for the line item.
  resource    String? @db.VarChar(2048)
  description String? @db.VarChar(280)

  settledAt DateTime? @map("settled_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  owner   User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing ApiListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  agent   Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([ownerId, reqId])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([payerAddress, createdAt(sort: Desc)])
  @@index([recipientAddress, createdAt(sort: Desc)])
  @@map("payments")
}

model Webhook {
  id                 String        @id @default(uuid(7))
  ownerId            String        @map("owner_id")
  url                String        @db.VarChar(2048)
  description        String?       @db.VarChar(255)
  events             String[]
  status             WebhookStatus @default(ENABLED)
  secretHash         String        @map("secret_hash")
  secretPrefix       String        @map("secret_prefix") @db.VarChar(32)
  lastDeliveryAt     DateTime?     @map("last_delivery_at")
  lastDeliveryStatus Int?          @map("last_delivery_status")
  failureCount       Int           @default(0) @map("failure_count")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  owner              User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("webhooks")
}

model Business {
  id                  String        @id @default(uuid(7))
  ownerId             String        @unique @map("owner_id")
  legalName           String        @default("") @map("legal_name") @db.VarChar(255)
  tradingName         String?       @map("trading_name") @db.VarChar(255)
  businessType        BusinessType? @map("business_type")
  registrationNumber  String?       @map("registration_number") @db.VarChar(64)
  taxId               String?       @map("tax_id") @db.VarChar(64)
  vatNumber           String?       @map("vat_number") @db.VarChar(64)
  industry            String?       @db.VarChar(128)
  website             String?       @db.VarChar(255)
  description         String?
  supportEmail        String?       @map("support_email") @db.VarChar(255)
  supportPhone        String?       @map("support_phone") @db.VarChar(20)
  addressLine1        String?       @map("address_line1") @db.VarChar(255)
  addressLine2        String?       @map("address_line2") @db.VarChar(255)
  city                String?       @db.VarChar(128)
  region              String?       @db.VarChar(128)
  postalCode          String?       @map("postal_code") @db.VarChar(32)
  country             String?       @db.VarChar(2)
  statementDescriptor String?       @map("statement_descriptor") @db.VarChar(22)
  payoutCurrency      String        @default("USD") @map("payout_currency") @db.VarChar(3)
  kybStatus           KybStatus     @default(UNVERIFIED) @map("kyb_status")
  kybVerifiedAt       DateTime?     @map("kyb_verified_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")
  owner               User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([kybStatus])
  @@map("businesses")
}

enum BannerInteractionType {
  VIEWED
  CLICKED
  DISMISSED
  VIDEO_PLAYED
}

model Banner {
  id           String    @id @default(uuid(7))
  slug         String    @unique @db.VarChar(64)
  title        String?   @db.VarChar(120)
  message      String?   @db.VarChar(280)
  url          String?   @db.VarChar(2048)
  thumbnailUrl String?   @map("thumbnail_url") @db.VarChar(2048)
  videoUrl     String?   @map("video_url") @db.VarChar(2048)
  alt          String?   @db.VarChar(160)
  isVideo      Boolean   @default(false) @map("is_video")
  priority     Int       @default(0)
  active       Boolean   @default(true)
  startsAt     DateTime? @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  interactions BannerInteraction[]

  @@index([active, startsAt, endsAt])
  @@map("banners")
}

model BannerInteraction {
  id        String                @id @default(uuid(7))
  bannerId  String                @map("banner_id")
  userId    String                @map("user_id")
  type      BannerInteractionType
  count     Int                   @default(1)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bannerId, userId, type])
  @@index([bannerId, type])
  @@index([userId])
  @@map("banner_interactions")
}

model Wallet {
  id          String         @id @default(uuid(7))
  ownerId     String         @map("owner_id")
  label       String         @db.VarChar(120)
  description String?        @db.VarChar(280)
  address     String         @db.VarChar(42)
  network     PaymentNetwork
  role        WalletRole     @default(BOTH)
  status      WalletStatus   @default(ACTIVE)
  isDefault   Boolean        @default(false) @map("is_default")

  verifiedAt         DateTime                 @map("verified_at")
  verificationMethod WalletVerificationMethod @default(EOA_SIGNATURE) @map("verification_method")
  verifiedChainId    Int                      @map("verified_chain_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  apiListings       ApiListing[]
  agentsAsRecipient Agent[]      @relation("AgentRecipientWallet")
  agentsAsPayer     Agent[]      @relation("AgentPayerWallet")

  @@unique([ownerId, address, network])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([address, network])
  @@map("wallets")
}

model WalletNonce {
  id      String         @id @default(uuid(7))
  userId  String         @map("user_id")
  address String         @db.VarChar(42)
  network PaymentNetwork
  nonce   String         @unique @db.VarChar(64)

  chainId   Int      @map("chain_id")
  domain    String   @db.VarChar(255)
  uri       String   @db.VarChar(2048)
  issuedAt  DateTime @map("issued_at")
  expiresAt DateTime @map("expires_at")

  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("wallet_nonces")
}

enum ReportReason {
  SCAM
  NOT_WORKING
  MISLEADING_PRICING
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Review {
  id        String  @id @default(uuid(7))
  listingId String? @map("listing_id")
  agentId   String? @map("agent_id")
  authorId  String  @map("author_id")

  rating Int
  title  String? @db.VarChar(120)
  body   String? @db.VarChar(2000)

  verifiedPurchase Boolean @default(false) @map("verified_purchase")

  ownerReply     String?   @map("owner_reply") @db.VarChar(2000)
  ownerRepliedAt DateTime? @map("owner_replied_at")

  hiddenAt     DateTime? @map("hidden_at")
  hiddenReason String?   @map("hidden_reason") @db.VarChar(280)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing ApiListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agent   Agent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([listingId, authorId])
  @@unique([agentId, authorId])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Report {
  id         String  @id @default(uuid(7))
  listingId  String? @map("listing_id")
  agentId    String? @map("agent_id")
  reporterId String  @map("reporter_id")

  reason ReportReason
  detail String?      @db.VarChar(2000)
  status ReportStatus @default(OPEN)

  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note") @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing  ApiListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agent    Agent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reporter User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("reports")
}

model ResourcePolicy {
  id        String  @id @default(uuid(7))
  listingId String? @unique @map("listing_id")
  agentId   String? @unique @map("agent_id")

  refundPolicy    String? @map("refund_policy") @db.VarChar(2000)
  uptimeTarget    String? @map("uptime_target") @db.VarChar(120)
  supportResponse String? @map("support_response") @db.VarChar(120)
  supportEmail    String? @map("support_email") @db.VarChar(320)
  rateLimit       String? @map("rate_limit") @db.VarChar(120)
  dataRetention   String? @map("data_retention") @db.VarChar(2000)
  testEndpoint    String? @map("test_endpoint") @db.VarChar(2048)

  termsUrl   String? @map("terms_url") @db.VarChar(2048)
  privacyUrl String? @map("privacy_url") @db.VarChar(2048)
  statusUrl  String? @map("status_url") @db.VarChar(2048)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing ApiListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agent   Agent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("resource_policies")
}
