enum SupportCategory {
  ACCOUNT
  BILLING
  PAYMENTS
  WALLETS
  AGENTS
  API_LISTINGS
  INTEGRATION
  COMPLIANCE
  BUG
  FEATURE_REQUEST
  OTHER
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportAuthor {
  CUSTOMER
  SUPPORT
}

model SupportRequest {
  id             String          @id @default(uuid(7))
  number         Int             @unique @default(autoincrement())
  organizationId String          @map("organization_id")
  createdById    String?         @map("created_by_id")
  subject        String          @db.VarChar(160)
  category       SupportCategory
  priority       SupportPriority @default(NORMAL)
  status         SupportStatus   @default(OPEN)
  description    String          @db.VarChar(5000)
  reference      String?         @db.VarChar(255)

  firstRespondedAt DateTime? @map("first_responded_at")
  resolvedAt       DateTime? @map("resolved_at")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdBy User?            @relation("SupportRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([organizationId, lastActivityAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("support_requests")
}

model SupportMessage {
  id        String        @id @default(uuid(7))
  requestId String        @map("request_id")
  author    SupportAuthor
  body      String        @db.VarChar(5000)

  createdAt DateTime @default(now()) @map("created_at")

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("support_messages")
}
