model BannerInteraction {
  id        String                @id @default(uuid(7))
  bannerId  String                @map("banner_id")
  userId    String                @map("user_id")
  type      BannerInteractionType
  count     Int                   @default(1)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bannerId, userId, type])
  @@index([bannerId, type])
  @@index([userId])
  @@map("banner_interactions")
}

model Wallet {
  id             String         @id @default(uuid(7))
  organizationId String         @map("organization_id")
  createdById    String?        @map("created_by_id")
  label          String         @db.VarChar(120)
  description    String?        @db.VarChar(280)
  address        String         @db.VarChar(42)
  network        PaymentNetwork
  role           WalletRole     @default(BOTH)
  status         WalletStatus   @default(ACTIVE)
  isDefault      Boolean        @default(false) @map("is_default")

  verifiedAt         DateTime                 @map("verified_at")
  verificationMethod WalletVerificationMethod @default(EOA_SIGNATURE) @map("verification_method")
  verifiedChainId    Int                      @map("verified_chain_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdBy User? @relation("WalletCreator", fields: [createdById], references: [id], onDelete: SetNull)

  apiListings       ApiListing[]
  agentsAsRecipient Agent[]      @relation("AgentRecipientWallet")
  agentsAsPayer     Agent[]      @relation("AgentPayerWallet")

  @@unique([organizationId, address, network])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([address, network])
  @@map("wallets")
}

model WalletNonce {
  id      String         @id @default(uuid(7))
