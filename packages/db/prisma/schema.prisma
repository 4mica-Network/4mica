enum ReportReason {
  SCAM
  NOT_WORKING
  MISLEADING_PRICING
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Review {
  id        String  @id @default(uuid(7))
  listingId String? @map("listing_id")
  agentId   String? @map("agent_id")
  authorId  String  @map("author_id")

  rating Int
  title  String? @db.VarChar(120)
  body   String? @db.VarChar(2000)

  verifiedPurchase Boolean @default(false) @map("verified_purchase")

  ownerReply     String?   @map("owner_reply") @db.VarChar(2000)
  ownerRepliedAt DateTime? @map("owner_replied_at")

  hiddenAt     DateTime? @map("hidden_at")
