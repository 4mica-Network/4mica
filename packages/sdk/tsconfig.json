{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@4mica/tsconfig/lib.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tsup.config.ts", "vitest.config.ts"]
}
