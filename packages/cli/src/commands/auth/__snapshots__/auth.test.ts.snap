// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`account > shows the account and its linked wallets > json shape: account 1`] = `
{
  "account": {
    "email": "string",
    "id": "string",
    "name": "string",
    "username": "string",
  },
  "context": {
    "environment": {
      "name": "string",
      "source": "string",
    },
    "organization": {
      "id": "null",
      "name": "null",
      "source": "string",
    },
    "project": {
      "id": "null",
      "name": "null",
      "source": "string",
    },
  },
  "wallets": [
    {
      "address": "string",
      "createdAt": "string",
      "id": "string",
      "isDefault": "boolean",
      "label": "string",
      "network": "string",
      "role": "string",
      "status": "string",
      "verifiedAt": "string",
    },
  ],
}
`;

exports[`auth login > shows a code, waits for approval, and keeps the token it is given > json shape: auth login 1`] = `
{
  "account": {
    "email": "string",
    "id": "string",
    "name": "string",
    "username": "string",
  },
  "apiUrl": "string",
  "organization": "null",
  "session": {
    "createdAt": "string",
    "expiresAt": "string",
    "id": "string",
    "kind": "string",
    "name": "string",
    "scopes": [
      "string",
    ],
  },
  "storage": "string",
}
`;

exports[`auth logout > revokes the token on the platform and forgets it here > json shape: auth logout 1`] = `
{
  "apiUrl": "string",
  "loggedOut": "boolean",
  "revoked": "boolean",
}
`;

