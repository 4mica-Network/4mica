// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cycles checkpoint > shows what it would sign on a dry run, and signs nothing > json shape: cycles checkpoint (dry run) 1`] = `
{
  "action": "string",
  "details": {
    "baseUnits": "string",
    "newSinceLastCheckpoint": "string",
    "payments": "string",
    "token": "string",
  },
  "dryRun": "boolean",
  "network": "string",
  "problems": [],
  "ready": "boolean",
  "wallet": "string",
}
`;

exports[`cycles checkpoint > signs the cycle it showed > json shape: cycles checkpoint 1`] = `
{
  "asset": "string",
  "covered": "number",
  "cumulativeGross": "string",
  "cycle": "string",
  "cycleIdText": "string",
}
`;

