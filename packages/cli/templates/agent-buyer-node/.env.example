# Runs in DEMO MODE as it is: the payment is a hand-built stand-in that only a
# demo seller accepts.
#
# To go live, copy this file to .env and set the wallet key. Payments are then
# signed for real through @4mica/sdk, up to 1 USDC each, against collateral
# the wallet has deposited:
#   4mica wallets create
#   4mica deposit 10 --asset USDC
# Docs: https://docs.4mica.io

# FOURMICA_WALLET_PRIVATE_KEY=0x...
# FOURMICA_NETWORK=base-sepolia

# A self-hosted core, in place of FOURMICA_NETWORK:
# FOURMICA_RPC_URL=http://localhost:3000

# Agent brain: set to have Claude generate/judge for real (offline fallback otherwise).
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-4-8
