# Runs in DEMO MODE as it is: a stand-in facilitator accepts any payment.
#
# To go live, copy this file to .env and set PAY_TO to the wallet you want to
# be paid at. Payments are then checked by the 4mica facilitator and
# guaranteed by 4mica core. A seller needs no key.
# `4mica wallets create` makes a wallet and prints its address.
# Docs: https://docs.4mica.io

# PAY_TO=0xYourWalletAddress

# A facilitator other than the hosted Base Sepolia one:
# FACILITATOR_URL=https://your-facilitator.example

# Agent brain: set to have Claude generate/judge for real (offline fallback otherwise).
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-4-8
