# 4Mica runs in DEMO MODE with zero config: a stand-in facilitator accepts any
# payment. To go live, pass new FourMicaFacilitatorClient() from
# @4mica/x402/server and set PAY_TO in the code to your wallet. No key needed.
# Docs: https://4mica.io/docs

# FACILITATOR_URL=https://testnet.payment.4mica.io

# Agent brain: set to have Claude generate/judge for real (offline fallback otherwise).
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-4-8
