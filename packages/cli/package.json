{
  "name": "@4mica/cli",
  "version": "0.3.0",
  "description": "Scaffold, run, and manage 4Mica agents and payment apps from the command line",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/4mica-Network/homepage.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/4mica-Network/homepage/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/4mica-Network/homepage/issues"
  },
  "keywords": [
    "4mica",
    "cli",
    "create",
    "scaffold",
    "x402",
    "payments",
    "agents"
  ],
  "bin": {
    "4mica": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "snapshot.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "oclif": {
    "bin": "4mica",
    "dirname": "4mica",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "helpClass": "./dist/help.js",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ],
    "hooks": {
      "command_not_found": "./dist/hooks/not-found.js"
    },
    "exitCodes": {
      "default": 1,
      "failedFlagParsing": 2,
      "failedFlagValidation": 2,
      "invalidArgsSpec": 2,
      "nonExistentFlag": 2,
      "requiredArgs": 2,
      "unexpectedArgs": 2,
      "violatedFlagConstraint": 2
    },
    "topics": {
      "guarantees": {
        "description": "check guarantee receipts"
      },
      "config": {
        "description": "show and change the cli's settings"
      }
    },
    "plugins": [
      "@oclif/plugin-autocomplete"
    ]
  },
  "scripts": {
    "prebuild": "node scripts/gen-snapshot.mjs",
    "build": "tsup",
    "gen:snapshot": "node scripts/gen-snapshot.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsup --silent && vitest run",
    "check:exports": "publint --strict",
    "check:snapshot": "node scripts/gen-snapshot.mjs && git diff --exit-code -- snapshot.json"
  },
  "dependencies": {
    "@4mica/sdk": "workspace:^",
    "@clack/prompts": "catalog:",
    "@oclif/core": "catalog:",
    "@oclif/plugin-autocomplete": "catalog:",
    "execa": "catalog:",
    "find-up": "catalog:",
    "ora": "catalog:",
    "picocolors": "catalog:",
    "undici": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@4mica/tsconfig": "workspace:*",
    "@4mica/url": "workspace:*",
    "@types/node": "catalog:node24",
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:typescript-latest",
    "vitest": "catalog:"
  }
}
