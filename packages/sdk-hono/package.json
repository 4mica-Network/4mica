{
  "name": "@4mica/sdk-hono",
  "version": "1.3.1",
  "description": "Hono middleware for gating routes behind a 4Mica x402 payment",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/4mica-Network/homepage.git",
    "directory": "packages/sdk-hono"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "4mica",
    "sdk",
    "hono",
    "x402",
    "middleware",
    "payments"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:exports": "attw --pack . --profile node16 && publint --strict"
  },
  "dependencies": {
    "@4mica/sdk": "workspace:*"
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "devDependencies": {
    "@4mica/tsconfig": "workspace:*",
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:node24",
    "hono": "catalog:",
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:typescript-latest",
    "vitest": "catalog:"
  }
}
