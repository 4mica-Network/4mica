{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "check:exports": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    },
    "seed": {
      "cache": false,
      "dependsOn": ["@4mica/db#build"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@4mica/db#build": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts", "package.json"],
      "outputs": ["src/generated/**"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@4mica/db#typecheck": {
      "dependsOn": ["@4mica/db#build"]
    },
    "@4mica/be#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@4mica/db#build"],
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
